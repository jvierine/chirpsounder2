[Unit]
Description=Shared 32-channel coded-sounder PFB frontend
After=chirpsounder_tgo.service
StartLimitIntervalSec=0

[Service]
ExecStart=%h/bin/iono-pfb %h/.config/chirpsounder2/pfb.json %t/iono-pfb.sock
Restart=always
RestartSec=5
Nice=0
CPUWeight=1000
CPUShares=10240
IOSchedulingClass=best-effort
IOSchedulingPriority=2
MemoryMax=1536M
LimitAS=3221225472
LimitCORE=0
NoNewPrivileges=yes

[Install]
WantedBy=default.target
