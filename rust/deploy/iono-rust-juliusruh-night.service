[Unit]
Description=TGO experimental Rust Juliusruh night processor
After=chirpsounder_tgo.service
PartOf=chirpsounder_tgo.service
[Service]
WorkingDirectory=%h/src/chirpsounder2/rust
ExecStart=%h/bin/iono-receiver digisonde %h/src/chirpsounder2/rust/deploy/tgo-juliusruh-night.json
Restart=always
RestartSec=5
MemoryMax=1500M
LimitAS=2147483648
[Install]
WantedBy=default.target
