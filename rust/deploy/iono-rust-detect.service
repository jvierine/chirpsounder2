[Unit]
Description=TGO experimental Rust chirp detection and consolidation
After=chirpsounder_tgo.service
PartOf=chirpsounder_tgo.service
[Service]
Nice=19
CPUQuota=100%
CPUWeight=1
WorkingDirectory=%h/src/chirpsounder2/rust
ExecStart=%h/bin/iono-receiver detect %h/src/chirpsounder2/rust/deploy/tgo-rust.json
Restart=always
RestartSec=5
MemoryMax=1500M
LimitAS=2147483648
[Install]
WantedBy=default.target
